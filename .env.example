APP_NAME=SSHWeb
APP_PORT=18080
NODE_ENV=production

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sshweb
MYSQL_USER=sshweb
MYSQL_PASSWORD=change_me_to_random_db_password

JWT_SECRET=change_me_to_long_random_string
JWT_EXPIRES_IN=7d

ENCRYPTION_KEY=change_me_to_long_random_encryption_key

SSH_CONNECT_TIMEOUT=10000
SSH_EXEC_TIMEOUT=60000
# 每用户并发终端会话上限
SSH_MAX_SESSIONS_PER_USER=20
# 终端单条输入帧大小上限（字节）
SSH_MAX_DATA_FRAME=1048576
ALLOW_QUERY_TOKEN=false
ALLOW_PLAIN_CREDENTIAL_EXPORT=false
CORS_ORIGINS=https://example.com
# Telegram通知
TG_ENABLED=false
TG_BOT_TOKEN=
TG_CHAT_ID=
ALERT_CPU_THRESHOLD=90
ALERT_SERVER_EXPIRY_DAYS=7
ALERT_REPEAT_HOURS=12
