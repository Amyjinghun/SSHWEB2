APP_NAME=SSHWeb
APP_PORT=3000
NODE_ENV=production

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sshweb
MYSQL_USER=sshweb
MYSQL_PASSWORD=sshweb123456

JWT_SECRET=change_me_to_random_string
JWT_EXPIRES_IN=7d

ENCRYPTION_KEY=change_me_to_32_byte_key

SSH_CONNECT_TIMEOUT=10000
SSH_EXEC_TIMEOUT=60000
ENABLE_DANGEROUS_COMMAND_BLOCK=true
